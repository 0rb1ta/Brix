<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Копия app/src/debug/AndroidManifest.xml: стенд шлёт команды эфира
             (START/STOP/RECONNECT/MUTE) прямо службе, а снаружи она открыта
             только в отладочных сборках. Список типов держать в согласии с
             streaming/src/main/AndroidManifest.xml — tools:node="replace"
             заменяет объявление целиком (см. комментарий в debug). -->
        <service
            android:name="app.brix.streaming.StreamService"
            android:exported="true"
            android:foregroundServiceType="camera|microphone|mediaProjection"
            tools:node="replace" />
    </application>
</manifest>
