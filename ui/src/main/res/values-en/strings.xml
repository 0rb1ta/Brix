    <string name="field_srt_latency">Latency (ms)</string>
    <string name="field_srt_latency_hint">Receiver buffer. Higher is more resilient to loss but adds delay. 100–10000, usually 2000.</string>
    <string name="field_srt_latency_low">Below 1000 ms our SRT implementation performs poorly: there is almost no window to resend a lost packet.</string>
    <string name="dialog_share_secrets_title">Include keys in the link?</string>
    <string name="dialog_share_secrets_text">The link can carry passwords and stream keys in plain text. Anyone who receives it can stream to your channel. Include keys only when moving settings to your own second device.</string>
    <string name="dialog_share_without_keys">Without keys</string>
    <string name="dialog_share_with_keys">With keys</string>
    <string name="settings_channel_priorities_hint">Bandwidth of all enabled links is summed. Weight sets each link’s share of the bonding.</string>
    <string name="settings_priority_weight">Weight</string>
    <string name="field_keyframe">Key frame (s)</string>
    <string name="field_keyframe_hint">Longer means less traffic but viewers wait longer for the first picture. 1–10, usually 2.</string>
    <string name="field_abr_algorithm">Algorithm</string>
    <string name="field_widget_refresh">Refresh interval (ms)</string>
    <string name="field_widget_refresh_hint">How often the widget frame is captured. More often is smoother but costs CPU. 50–5000, usually 200.</string>
    <string name="advanced_record_hint">MP4 alongside the stream, from the same encoder. About 30 MB per minute. Files live in the app folder and are removed with it.</string>
    <string name="advanced_debug_log">Session log</string>
    <string name="advanced_debug_log_hint">Writes power, temperature, thermal status and transport figures to a file once a second. For runs where no cable can be attached — a long outing on a power bank. About 1 MB per two hours.</string>
    <string name="advanced_debug_log_share">Share latest recording</string>
    <string name="advanced_debug_log_none">none</string>
